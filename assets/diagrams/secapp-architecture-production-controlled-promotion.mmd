flowchart TB
    subgraph internet[Internet]
        direction TB
        endpoint[Endpoint agents]
        cve[External CVE source]
    end

    subgraph dmz_zone[DMZ]
        direction TB
        inv_ingress[DMZ inventory ingress]
        cve_ingress[DMZ CVE ingress]
        dmz[(dmz_postgres)]
    end

    subgraph prod_zone[Production]
        direction TB

        subgraph prod_promoters[Production Promotion Service]
            direction TB
            lease[Production claim / lease]
            promoters[Inventory and CVE promoters]
            accept[Revalidation / acceptance]
        end

        prod[(prod-secapp-postgres<br/>accepted state + source references)]

        subgraph correlation_engine[Correlation Engine]
            direction TB
            correlation[Correlation engine<br/>explainable exposure findings]
        end

        panel[Security Operations Panel<br/>workflow and governance]
    end

    cve --> cve_ingress
    endpoint --> inv_ingress

    cve_ingress --> dmz
    inv_ingress --> dmz

    dmz -->|staged records claimed by Production| lease
    lease --> promoters
    promoters --> accept
    accept --> prod
    prod --> correlation
    correlation --> panel

    scheduler[Scheduler]:::planned -.-> promoters
    provider[Live provider integration]:::planned -.-> cve_ingress
    rbac[Enterprise identity / RBAC]:::planned -.-> panel
    retention[Retention management]:::planned -.-> prod
    admin[Full Admin controls]:::planned -.-> panel

