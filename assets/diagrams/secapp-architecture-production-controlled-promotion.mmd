    classDef planned fill:#f5f5f5,stroke:#7a7a7a,stroke-width:1.5px,stroke-dasharray:6 4,color:#444;
    classDef datastore fill:#f1ede7,stroke:#8b0000,stroke-width:2px,color:#222;
    classDef zone fill:#fbfbfb,stroke:#b8b8b8,stroke-width:1.5px,color:#222;
    classDef implementedGroup fill:#fffde8,stroke:#b7ad45,stroke-width:1.5px,color:#222;

    class cve_ingress,inv_ingress,lease,promoters,accept,correlation,panel implemented;
    class scheduler,provider,rbac,retention,admin planned;
